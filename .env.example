# ---------- Backend ----------
# Key pool: comma-separated, at least 2. Ids are key_1, key_2, ... in this order. Never commit real keys.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name used by every key (provider/model). Examples: gemini/gemini-2.0-flash, groq/llama-3.1-8b-instant
LLM_MODEL=gemini/gemini-2.0-flash
# Optional: one model per key, same order as LLM_API_KEYS (mix providers, e.g. gemini key + groq key)
LLM_KEY_MODELS=
# SQLite file inside the Docker volume
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test hook (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true
# LiteLLM response cache: CACHE_TYPE=local (in-memory) or disk (persists under CACHE_DIR)
CACHE_ENABLED=true
CACHE_TYPE=disk
CACHE_DIR=/data/llm-cache
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Per-key timeout before failing over, and generation settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.3
# true = LiteLLM mock replies (no real provider calls) for local development only
LLM_MOCK=false

# ---------- Frontend ----------
# Runtime backend URL written into config.js by the frontend container
API_BASE_URL=http://localhost:8000
# Build-time fallback (used by Vercel/Netlify builds)
VITE_API_BASE_URL=http://localhost:8000
